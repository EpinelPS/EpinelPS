@using EpinelPS.Models.Admin
@model MessengerInspectionModel

@{
    ViewData["Title"] = "Messenger Inspector";
}

<div class="adminui-dashboard messenger-management">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 mb-1" data-i18n="users.messenger.title">Messenger Inspector</h1>
            <p class="text-muted mb-0">User @Model.UserId · Read-only diagnostics</p>
        </div>
        <a asp-action="Modify" asp-route-id="@Model.UserId" class="btn btn-outline-light">
            <i class="fas fa-arrow-left me-2"></i><span data-i18n="users.messenger.backToUser">Back to User</span>
        </a>
    </div>

    <div class="alert alert-info" data-i18n="users.messenger.safetyText">
        This page is read-only. It never creates messages or changes triggers, rooms, quests, or character progress.
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3"><div class="card text-center"><div class="card-body"><div class="text-muted">Message records</div><div class="display-6">@Model.MessageCount</div></div></div></div>
        <div class="col-md-4 mb-3"><div class="card text-center"><div class="card-body"><div class="text-muted">Conversations</div><div class="display-6">@Model.ConversationCount</div></div></div></div>
        <div class="col-md-4 mb-3"><div class="card text-center"><div class="card-body"><div class="text-muted">Rooms represented</div><div class="display-6">@Model.RoomCount</div></div></div></div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="mb-0" data-i18n="users.messenger.recordsTitle">Current Message Records</h3>
            <input id="messageFilter" class="form-control form-control-sm w-auto" placeholder="Filter ID / room" aria-label="Filter message records" />
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover mb-0" id="messageTable">
                <thead><tr><th>Seq</th><th>Conversation</th><th>Message</th><th>State</th><th>Static data</th><th>Condition</th><th>Room</th><th>Room condition</th><th>Created (UTC)</th></tr></thead>
                <tbody>
                @foreach (MessengerRecordInspection record in Model.Records)
                {
                    <tr>
                        <td>@record.Seq</td>
                        <td><code>@record.ConversationId</code></td>
                        <td><code>@record.MessageId</code>@if (record.IsOpener) { <span class="badge text-bg-info ms-1">opener</span> }</td>
                        <td>@record.State</td>
                        <td>@record.StaticStatus</td>
                        <td class="small">@(record.ConditionId is int id ? $"#{id} · {record.ConditionType} · {record.TriggerCount} trigger(s) · {record.ConditionStatus}" : record.ConditionStatus)</td>
                        <td>@(string.IsNullOrEmpty(record.RoomId) ? "—" : record.RoomId)</td>
                        <td class="small">@record.RoomCondition@(record.RoomUnlocked is bool unlocked ? unlocked ? " · unlocked" : " · locked" : "")</td>
                        <td class="small">@(record.CreatedAtUtc?.ToString("u") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById('messageFilter').addEventListener('input', function () {
        const filter = this.value.toLowerCase();
        document.querySelectorAll('#messageTable tbody tr').forEach(row => row.hidden = !row.textContent.toLowerCase().includes(filter));
    });
</script>
