@model EpinelPS.Models.Admin.ModUserModel

@{
    ViewData["Title"] = "修改用户";
}

<div class="adminui-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 mb-0" data-i18n="users.modify.title">修改用户信息</h1>
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="fas fa-arrow-left me-2"></i> <span data-i18n="users.modify.backToList">返回列表</span>
        </a>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0" data-i18n="users.modify.subtitle">用户信息</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Modify">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Username" class="form-label" data-i18n="users.table.username">用户名</label>
                                    <input asp-for="Username" class="form-control" />
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Nickname" class="form-label" data-i18n="users.table.nickname">昵称</label>
                                    <input asp-for="Nickname" class="form-control" />
                                    <span asp-validation-for="Nickname" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="adminui-checkbox-group">
                                    <div class="adminui-checkbox mb-2">
                                        <input asp-for="IsAdmin" class="adminui-checkbox-input" />
                                        <label asp-for="IsAdmin" class="adminui-checkbox-label" data-i18n="users.modify.isAdmin">管理员权限</label>
                                        <span asp-validation-for="IsAdmin" class="text-danger"></span>
                                    </div>

                                    <div class="adminui-checkbox mb-2">
                                        <input asp-for="sickpulls" class="adminui-checkbox-input" data-i18n-title="users.modify.disableGachaHint" />
                                        <label asp-for="sickpulls" class="adminui-checkbox-label" data-i18n="users.modify.disableGacha" data-i18n-title="users.modify.disableGachaHint">禁用抽卡系统</label>
                                        <span asp-validation-for="sickpulls" class="text-danger"></span>
                                    </div>

                                    <div class="adminui-checkbox">
                                        <input asp-for="IsBanned" class="adminui-checkbox-input" />
                                        <label asp-for="IsBanned" class="adminui-checkbox-label" data-i18n="users.modify.isBanned">禁止登录</label>
                                        <span asp-validation-for="IsBanned" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i> <span data-i18n="common.save">保存</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0" data-i18n="users.modify.cheats">作弊功能</h3>
                </div>
                <div class="card-body">
                    <div class="cheats-section mb-4">
                        <h4 class="section-title" data-i18n="users.modify.campaign">战役</h4>
                        <div class="button-group">
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('complete-stage', '@Model.ID', 'Enter chapter number and stage number (e.g. 1 2)')">
                                <i class="fas fa-forward me-2"></i> <span data-i18n="users.modify.skipStages">跳过关卡</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmd('complete-all-stages', '@Model.ID')">
                                <i class="fas fa-flag-checkered me-2"></i> <span data-i18n="users.modify.completeAllStages">完成所有主线关卡</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmd('complete-all-event-stages', '@Model.ID')">
                                <i class="fas fa-flag me-2"></i> <span data-i18n="users.modify.completeAllEventStages">完成所有活动关卡</span>
                            </button>
                            <button class="btn btn-danger" onclick="if (confirm(i18n.t('users.modify.unlockAllSubquestConfirm'))) runSimpleCmd('unlock-all-subquest-messages', '@Model.ID')">
                                <i class="fas fa-unlock-alt me-2"></i> <span data-i18n="users.modify.unlockAllSubquestMessages">Cheat：解锁所有支线对话</span>
                            </button>
                        </div>
                    </div>

                    <div class="cheats-section mb-4">
                        <h4 class="section-title" data-i18n="users.modify.characters">Characters:</h4>
                        <div class="button-group">
                            <button class="btn btn-accent" onclick="runSimpleCmd('add-all-characters', '@Model.ID')">
                                <i class="fas fa-users me-2"></i> <span data-i18n="users.modify.addAllChars">添加所有角色</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmd('add-all-costumes', '@Model.ID')">
                                <i class="fas fa-tshirt me-2"></i> <span data-i18n="users.modify.addAllCostumes">添加所有服装</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmd('add-all-collections', '@Model.ID')">
                                <i class="fas fa-gem me-2"></i> <span data-i18n="users.modify.addAllCollections">添加所有收藏品</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('add-character', '@Model.ID', 'Enter character ID. Wrong ID may cause game not to boot.')">
                                <i class="fas fa-user-plus me-2"></i> <span data-i18n="users.modify.addChar">添加角色</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('set-level', '@Model.ID', 'Enter level (1-999) to apply to all characters')">
                                <i class="fas fa-level-up-alt me-2"></i> <span data-i18n="users.modify.setCharLevels">设置角色等级</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('set-skill-level', '@Model.ID', 'Enter skill level (1-10) to apply to all characters')">
                                <i class="fas fa-bolt me-2"></i> <span data-i18n="users.modify.setSkillLevels">设置技能等级</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('set-core-level', '@Model.ID', 'core level / 0-3 sets stars')">
                                <i class="fas fa-star me-2"></i> <span data-i18n="users.modify.setCoreLevel">设置核心等级</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('set-all-bond-level', '@Model.ID', 'Enter bond level (1-30)')">
                                <i class="fas fa-heart me-2"></i> <span data-i18n="users.modify.setBondLevel">设置角色好感度</span>
                            </button>
                        </div>
                    </div>

                    <div class="cheats-section mb-4">
                        <h4 class="section-title" data-i18n="users.modify.inventory">Inventory</h4>
                        <div class="button-group">
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('add-all-materials', '@Model.ID', 'Enter material amount:')">
                                <i class="fas fa-tools me-2"></i> <span data-i18n="users.modify.addAllEquip">添加所有装备</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('add-item', '@Model.ID', 'Enter item ID and amount (e.g. 100 5)')">
                                <i class="fas fa-box-open me-2"></i> <span data-i18n="users.modify.addItem">添加物品</span>
                            </button>
                            <a asp-action="Currency" asp-route-id="@Model.ID">
                                <button class="btn btn-accent">
                                    <i class="fas fa-coins me-2"></i> <span data-i18n="users.modify.addCurrency">Add Currency</span>
                                </button>
                            </a>
                        </div>
                    </div>

                    <div class="cheats-section">
                        <h4 class="section-title" data-i18n="users.modify.misc">其他</h4>
                        <div class="button-group">
                            <button class="btn btn-accent" onclick="runSimpleCmd('finish-all-tutorials', '@Model.ID')">
                                <i class="fas fa-graduation-cap me-2"></i> <span data-i18n="users.modify.finishTutorials">完成所有教程</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('skip-tower', '@Model.ID', 'Skip tower floor for the selected user, towerid floor (Elysion=1, Misslis=2, Tetra=3, Pilgrim=4, Tribe=5) e.g 1 234')">
                                <i class="fas fa-building me-2"></i> <span>Skip Tower Floors</span>
                            </button>
                            <a asp-action="Messenger" asp-route-id="@Model.ID" class="btn btn-accent">
                                <i class="fas fa-comments me-2"></i> <span data-i18n="users.modify.messenger">Manage Messenger</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid mt-3">
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
            <input type="text" id="charFilter" class="form-control" style="max-width:320px"
                   placeholder="搜索角色名 / TID" data-i18n-placeholder="users.modify.charFilterPlaceholder" />
            <select id="corpFilter" class="form-select" style="max-width:240px">
                <option value="" data-i18n="users.modify.allManufacturers">全部厂商</option>
                @foreach (var corp in Model.Characters.Select(c => c.Manufacturer).Distinct().OrderBy(x => x))
                {
                    <option value="@corp">@corp</option>
                }
            </select>
            <select id="elementFilter" class="form-select" style="max-width:160px">
                <option value="" data-i18n="users.modify.allElements">全部代码</option>
                @foreach (var element in Model.Characters.Select(c => c.ElementName).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x))
                {
                    <option value="@element">@element</option>
                }
            </select>
            <select id="weaponFilter" class="form-select" style="max-width:160px">
                <option value="" data-i18n="users.modify.allWeapons">全部武器</option>
                @foreach (var weapon in Model.Characters.Select(c => c.WeaponType).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x))
                {
                    <option value="@weapon">@weapon</option>
                }
            </select>
            <div class="form-check form-switch mb-0 ms-2">
                <input class="form-check-input" type="checkbox" id="nameDisplayToggle" />
                <label class="form-check-label" for="nameDisplayToggle"><span data-i18n="users.modify.show">Show</span> <span id="nameDisplayLabel">Name</span></label>
            </div>
            <div class="ms-auto text-muted small" id="charCount"></div>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" id="charTable">
                <thead>
                    <tr>
                        <th style="width:40%" data-i18n="users.modify.colCharacter">角色</th>
                        <th data-i18n="users.modify.colLevel">等级</th>
                        <th data-i18n="users.modify.colSkills">技能 1 / 2 / 3</th>
                        <th data-i18n="users.modify.colRarity">品级</th>
                        <th data-i18n="users.modify.colBreaks">突破</th>
                        <th data-i18n="users.modify.colGearCount">装备数</th>
                        <th style="width:150px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var character in Model.Characters)
                    {
                        <tr data-csn="@character.Csn" data-name="@character.Name" data-tid="@character.Tid" data-corp="@character.Manufacturer" data-element="@character.ElementName" data-weapon="@character.WeaponType">
                            <td>
                                <span class="text-muted small me-2">@character.Tid</span>
                                <span class="character-name" data-name="@character.Name" data-character-tid="@character.Tid">@character.Name</span>
                                @if (!string.IsNullOrEmpty(character.Tags))
                                {
                                    <span class="text-muted small ms-2">@character.Tags</span>
                                }
                            </td>
                            <td>
                                LV@(character.Level)
                                @if (character.IsSynchro)
                                {
                                    <span class="badge bg-warning text-dark ms-1" data-i18n="users.modify.synchro" data-i18n-title="users.modify.synchroTooltip" title="同步器等级">同步</span>
                                }
                            </td>
                            <td>@character.Skill1 / @character.Skill2 / @character.BurstSkill</td>
                            <td>@character.Rarity</td>
                            <td>@character.BreakCount</td>
                            <td>
                                @if (character.GearCount > 0)
                                {
                                    <span class="badge bg-info">@character.GearCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td>
                                <button type="button" class="btn btn-accent btn-sm js-load-detail text-nowrap"
                                        data-csn="@character.Csn"
                                        data-url="@Url.Action("CharacterDetail", new { id = Model.ID })">
                                    <i class="fas fa-tools me-1"></i> <span data-i18n="users.modify.viewEdit">查看/编辑</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="gearModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="gearModalTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="gearModalBody">
                    <div class="text-center p-5"><div class="spinner-border"></div></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Character list filter and lazy loaded character detail modal
        (function () {
            const filterInput = document.getElementById("charFilter");
            const corpSelect = document.getElementById("corpFilter");
            const elementSelect = document.getElementById("elementFilter");
            const weaponSelect = document.getElementById("weaponFilter");
            const countLabel = document.getElementById("charCount");
            const modalEl = document.getElementById("gearModal");
            const modalBody = document.getElementById("gearModalBody");
            const modalTitle = document.getElementById("gearModalTitle");
            let modal = null;
            function tr(key, params, fallback) {
                return (window.i18n && typeof window.i18n.t === "function")
                    ? window.i18n.t(key, params) : fallback;
            }

            function applyFilter() {
                const query = (filterInput.value || "").trim().toLowerCase();
                const corp = corpSelect.value;
                const element = elementSelect.value;
                const weapon = weaponSelect.value;
                let visible = 0;
                let total = 0;

                document.querySelectorAll("#charTable tbody tr").forEach(function (row) {
                    if (row.id === "charTableEmpty") return;
                    total++;
                    const name = (row.dataset.name || "").toLowerCase();
                    const tid = row.dataset.tid || "";
                    const matchQuery = !query || name.includes(query) || tid.includes(query);
                    const matchCorp = !corp || row.dataset.corp === corp;
                    const matchElement = !element || row.dataset.element === element;
                    const matchWeapon = !weapon || row.dataset.weapon === weapon;
                    const show = matchQuery && matchCorp && matchElement && matchWeapon;
                    row.style.display = show ? "" : "none";
                    if (show) visible++;
                });

                const tbody = document.querySelector("#charTable tbody");
                let emptyRow = document.getElementById("charTableEmpty");
                if (visible === 0 && total > 0) {
                    if (!emptyRow) {
                        emptyRow = document.createElement("tr");
                        emptyRow.id = "charTableEmpty";
                        emptyRow.innerHTML = '<td colspan="7" class="text-center text-muted py-4" data-i18n="users.modify.noResults">'
                            + tr("users.modify.noResults", {}, "没有匹配的角色") + '</td>';
                        tbody.appendChild(emptyRow);
                    }
                } else if (emptyRow) {
                    emptyRow.remove();
                }

                countLabel.textContent = visible === total
                    ? tr("users.modify.charCount", { count: total }, total + " 个角色")
                    : tr("users.modify.charCountFiltered", { visible: visible, total: total }, visible + " / " + total + " 个角色");
            }

            filterInput.addEventListener("input", applyFilter);
            corpSelect.addEventListener("change", applyFilter);
            elementSelect.addEventListener("change", applyFilter);
            weaponSelect.addEventListener("change", applyFilter);
            applyFilter();
            window.addEventListener("adminui:i18n-ready", applyFilter);

            document.querySelectorAll(".js-load-detail").forEach(function (button) {
                button.addEventListener("click", async function () {
                    const csn = button.dataset.csn;
                    const row = button.closest("tr");
                    const nameCell = row.querySelector(".character-name");

                    modalTitle.textContent = nameCell ? nameCell.textContent : "";
                    modalBody.innerHTML = "<div class=\"text-center p-5\"><div class=\"spinner-border\"></div></div>";

                    const response = await fetch(button.dataset.url + "?csn=" + encodeURIComponent(csn));
                    if (!response.ok) {
                        modalBody.innerHTML = '<div class="alert alert-danger">' + tr("users.modify.loadFailed", {}, "Failed to load character detail.") + '</div>';
                    } else {
                        modalBody.innerHTML = await response.text();
                    }

                    if (!modal) {
                        modal = new bootstrap.Modal(modalEl);
                    }
                    modal.show();
                });
            });
        })();

        // Character names are rendered on the server, so a language switch needs a fresh page
        // request for the cookie to take effect.
        window.addEventListener('adminui:languageChanged', function () {
            location.reload();
        });
    </script>
</div>

<style>
    /* _Layout footer is fixed; reserve space so the table is not covered. */
    .adminui-dashboard { padding-bottom: 80px; }

    /* Keep the translated headers and badges on a single line. */
    #charTable th, #charTable td { white-space: nowrap; }

    /* adminui风格卡片标题 */
    .card-header {
        background-color: var(--adminui-primary);
        color: var(--adminui-light);
        font-weight: 600;
        letter-spacing: 1px;
        padding: 15px 20px;
    }

    .card-header h3 {
        margin: 0;
        font-size: 1.2rem;
    }

    /* 作弊功能部分 */
    .cheats-section {
        margin-bottom: 20px;
    }

    .section-title {
        color: var(--adminui-accent);
        font-size: 1.1rem;
        margin-bottom: 10px;
        font-weight: 600;
        letter-spacing: 1px;
        border-bottom: 1px solid var(--adminui-gray);
        padding-bottom: 8px;
    }

    .button-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    /* 自定义按钮 */
    .btn-accent {
        background-color: var(--adminui-accent-dark);
        color: white;
        border: none;
        transition: all var(--transition-fast);
    }

    .btn-accent:hover {
        background-color: var(--adminui-accent);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(232, 62, 140, 0.4);
        color: white;
    }

    /* 自定义复选框样式 */
    .adminui-checkbox-group {
        margin-top: 10px;
    }

    .adminui-checkbox {
        display: flex;
        align-items: center;
        margin-bottom: 0;
    }

    .adminui-checkbox-input {
        position: absolute;
        opacity: 0;
        height: 0;
        width: 0;
    }

    .adminui-checkbox-label {
        position: relative;
        padding-left: 30px;
        cursor: pointer;
        user-select: none;
    }

    .adminui-checkbox-label:before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 20px;
        height: 20px;
        background-color: var(--adminui-gray);
        border: 1px solid var(--adminui-gray-light);
        border-radius: var(--radius-sm);
        transition: all var(--transition-fast);
    }

    .adminui-checkbox-input:checked + .adminui-checkbox-label:before {
        background-color: var(--adminui-accent);
        border-color: var(--adminui-accent);
    }

    .adminui-checkbox-label:after {
        content: '\f00c';
        font-family: 'Font Awesome 5 Free', serif;
        font-weight: 900;
        position: absolute;
        left: 3px;
        top: 1px;
        color: white;
        opacity: 0;
        transition: opacity var(--transition-fast);
        font-size: 14px;
    }

    .adminui-checkbox-input:checked + .adminui-checkbox-label:after {
        opacity: 1;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Restore scroll position
        const savedScroll = localStorage.getItem('scrollPosition');
        if (savedScroll) {
            window.scrollTo(0, parseInt(savedScroll));
        }

        // --- Name display toggle ---
        const nameToggle = document.getElementById('nameDisplayToggle');
        const nameLabel = document.getElementById('nameDisplayLabel');
        const characterNames = document.querySelectorAll('.character-name');

        // Load saved preference (default: name)
        const showCharacterTid = localStorage.getItem('showCharacterTid') === 'true';
        nameToggle.checked = showCharacterTid;
        updateNameDisplay(showCharacterTid);

        nameToggle.addEventListener('change', function() {
            const showTid = this.checked;
            localStorage.setItem('showCharacterTid', showTid);
            updateNameDisplay(showTid);
        });

        function updateNameDisplay(showTid) {
            nameLabel.textContent = showTid ? 'TID'
                : ((window.i18n && typeof window.i18n.t === 'function') ? window.i18n.t('users.modify.name') : 'Name');
            characterNames.forEach(el => {
                const name = el.getAttribute('data-name');
                const characterTid = el.getAttribute('data-character-tid');
                // The TID is always visible in front, so hide the name instead of repeating the TID
                el.style.display = showTid ? 'none' : '';
                // Update tooltip title to the opposite value
                el.setAttribute('title', showTid ? name : characterTid);
            });
        }

        // The i18n script loads after this inline script, refresh the label once it is ready.
        window.addEventListener('adminui:i18n-ready', function () {
            updateNameDisplay(nameToggle.checked);
        });

        // --- Collapse state handling ---
        const collapsedCards = JSON.parse(localStorage.getItem('collapsedCards') || '{}');
        document.querySelectorAll('.collapse').forEach(collapse => {
            const collapseId = collapse.id;
            if (collapsedCards[collapseId] === true) {
                collapse.classList.remove('show');
            } else if (collapsedCards[collapseId] === false) {
                collapse.classList.add('show');
            }
        });

        let scrollTimeout;
        window.addEventListener('scroll', function() {
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                localStorage.setItem('scrollPosition', window.scrollY);
            }, 100);
        });

        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
            button.addEventListener('click', function() {
                const targetId = this.getAttribute('data-bs-target').replace('#', '');
                const targetCollapse = document.getElementById(targetId);

                setTimeout(() => {
                    const collapsedCards = JSON.parse(localStorage.getItem('collapsedCards') || '{}');
                    collapsedCards[targetId] = !targetCollapse.classList.contains('show');
                    localStorage.setItem('collapsedCards', JSON.stringify(collapsedCards));
                }, 100);
            });
        });

        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function() {
                localStorage.setItem('scrollPosition', window.scrollY);
            });
        });
    });
</script>
